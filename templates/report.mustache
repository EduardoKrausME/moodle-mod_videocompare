{{!
    @template mod_videocompare/report

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="mod-videocompare-report">
    {{#detail}}
        <div class="mb-3">
            <a class="btn btn-outline-secondary" href="{{{backurl}}}">{{#str}}backtoreport, videocompare{{/str}}</a>
        </div>
        <h2>{{#str}}studentreport, videocompare{{/str}}: {{name}}</h2>
        <p><strong>{{#str}}overallprogress, videocompare{{/str}}:</strong> {{overall}}%</p>
        <p><strong>{{#str}}requiredanswered, videocompare{{/str}}:</strong> {{requiredanswered}} / {{requiredtotal}}</p>

        <h3>{{#str}}videos, videocompare{{/str}}</h3>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>{{#str}}video, videocompare{{/str}}</th>
                    <th>{{#str}}progress, videocompare{{/str}}</th>
                    <th>{{#str}}watched, videocompare{{/str}}</th>
                    <th>{{#str}}lastposition, videocompare{{/str}}</th>
                </tr>
                </thead>
                <tbody>
                {{#videos}}
                    <tr>
                        <td>{{name}}</td>
                        <td>{{percent}}%</td>
                        <td>{{watched}}</td>
                        <td>{{lastposition}}</td>
                    </tr>{{/videos}}
                </tbody>
            </table>
        </div>

        <h3>{{#str}}questions, videocompare{{/str}}</h3>
        {{#hasanswers}}
            {{#answers}}
                <div class="card mb-3">
                    <div class="card-body">
                        <div>{{{questionhtml}}} {{#required}}
                            <span class="badge bg-danger">{{#str}}required, videocompare{{/str}}</span>{{/required}}
                        </div>
                        {{#hasanswer}}
                            <div class="mt-2">{{answer}}</div>{{/hasanswer}}
                        {{^hasanswer}}
                            <div class="mt-2 text-muted">—</div>{{/hasanswer}}
                    </div>
                </div>
            {{/answers}}
        {{/hasanswers}}

        <h3>{{#str}}savedcomparisons, videocompare{{/str}}</h3>
        {{#hasnotes}}
            <div class="list-group">
                {{#notes}}
                    <div class="list-group-item">
                        <strong>{{videoaname}} — {{timea}}</strong> ↔ <strong>{{videobname}} — {{timeb}}</strong>
                        <div>{{note}}</div>
                    </div>
                {{/notes}}
            </div>
        {{/hasnotes}}
        {{^hasnotes}}<p class="text-muted">{{#str}}nocomparisons, videocompare{{/str}}</p>{{/hasnotes}}
    {{/detail}}

    {{^detail}}
        <h2>{{#str}}reports, videocompare{{/str}} — {{name}}</h2>
        {{#hasrows}}
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                    <tr>
                        <th>{{#str}}student, videocompare{{/str}}</th>
                        <th>{{#str}}overallprogress, videocompare{{/str}}</th>
                        {{#videos}}
                            <th>{{name}}</th>{{/videos}}
                        <th>{{#str}}requiredanswered, videocompare{{/str}}</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#rows}}
                        <tr>
                            <td>{{name}}</td>
                            <td>{{overall}}%</td>
                            {{#pervideo}}
                                <td><span title="{{name}}">{{percent}}%</span></td>{{/pervideo}}
                            <td>{{requiredanswered}} / {{requiredtotal}}</td>
                            <td><a class="btn btn-sm btn-outline-primary" href="{{{detailsurl}}}">{{#str}}
                                viewdetails, videocompare{{/str}}</a></td>
                        </tr>
                    {{/rows}}
                    </tbody>
                </table>
            </div>
        {{/hasrows}}
        {{^hasrows}}<p>{{#str}}nocontent, videocompare{{/str}}</p>{{/hasrows}}
    {{/detail}}
</div>
